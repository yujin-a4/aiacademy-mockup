# Supabase (클라이언트 공개 가능)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 롤 키 (서버사이드 only, 절대 git에 올리지 마세요)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (서버사이드 only - API Route에서만 사용)
GEMINI_API_KEY=

# Google Cloud Vision API (서버사이드 only)
GOOGLE_CLOUD_API_KEY=

# Google Cloud TTS (서버사이드 only)
GOOGLE_TTS_API_KEY=

# Vertex AI (/api/tutor-vertex 테스트용, 서버사이드 only)
# GOOGLE_APPLICATION_CREDENTIALS는 서비스 계정 키 JSON 파일 경로 (repo 루트에 두면 gitignore로 자동 제외됨)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-vertex-key.json

# Firebase (클라이언트 공개 가능 - NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Anam (립싱크 실측 하네스 /lipsync-test 전용, 서버사이드 only)
# lab.anam.ai 가입 후 API 키 발급. 아바타 id는 화면에서 직접 입력하거나 여기 기본값으로 둔다.
ANAM_API_KEY=
ANAM_AVATAR_ID=
# 배포본에서도 /lipsync-test 를 열어야 할 때만 1 (기본은 프로덕션에서 404)
NEXT_PUBLIC_ENABLE_LIPSYNC_TEST=

# ElevenLabs (서버사이드 only) — 강사 TTS(/api/tts)·STT(/api/stt)에서 사용
# 강사별 voice ID는 src/data/instructorData.ts 의 INST_VOICE 에 박혀 있으므로,
# **그 voice 를 보유한 계정의 키**여야 한다. 다른 계정 키면 voice not found 가 난다.
ELEVENLABS_API_KEY=
# 강사 voice 가 지정되지 않았을 때 쓸 기본 목소리 (선택)
ELEVENLABS_VOICE_ID=

# Gemini API (서버사이드 only - API Route에서만 사용)
GEMINI_API_KEY=

# Google Cloud Vision API (서버사이드 only)
GOOGLE_CLOUD_API_KEY=

# Google Cloud TTS (서버사이드 only)
GOOGLE_TTS_API_KEY=

# Vertex AI (/api/tutor-vertex 테스트용, 서버사이드 only)
# GOOGLE_APPLICATION_CREDENTIALS는 서비스 계정 키 JSON 파일 경로 (repo 루트에 두면 gitignore로 자동 제외됨)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-vertex-key.json

# Firebase (클라이언트 공개 가능 - NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
